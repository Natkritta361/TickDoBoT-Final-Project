# TickDoBot — Environment Variables
# Copy this file to .env and fill in your values

# ── LINE ─────────────────────────────────────────────────────────────────────
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here
LINE_CHANNEL_SECRET=your_channel_secret_here

# ── LIFF ─────────────────────────────────────────────────────────────────────
# Base URL where your LIFF pages are served (no trailing slash)
LIFF_BASE_URL=https://your-domain.com

# ── Firebase ─────────────────────────────────────────────────────────────────
# Option A: JSON string of service account key (good for Cloud Run / Railway)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# Option B: Path to service account JSON file (local dev)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccount.json

FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production
